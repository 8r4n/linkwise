{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Linkwise: build whitepaper",
      "type": "shell",
      "command": "bash tools/build-whitepaper.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Linkwise: format check",
      "type": "shell",
      "command": "cargo fmt --check",
      "options": {
        "cwd": "${workspaceFolder}/rust"
      },
      "problemMatcher": []
    },
    {
      "label": "Linkwise: clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets -- -D warnings",
      "options": {
        "cwd": "${workspaceFolder}/rust"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Linkwise: test",
      "type": "shell",
      "command": "cargo test",
      "options": {
        "cwd": "${workspaceFolder}/rust"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Linkwise: cross-target check",
      "type": "shell",
      "command": "for target in aarch64-apple-darwin x86_64-apple-darwin aarch64-pc-windows-msvc x86_64-pc-windows-msvc aarch64-unknown-linux-gnu x86_64-unknown-linux-gnu; do cargo check --target \"$target\" || exit 1; done",
      "options": {
        "cwd": "${workspaceFolder}/rust"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Linkwise: verify",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Linkwise: format check",
        "Linkwise: clippy",
        "Linkwise: test",
        "Linkwise: cross-target check"
      ],
      "problemMatcher": []
    }
  ]
}
