---
import "../styles/global.css";
import HeadSEO from "../components/HeadSEO.astro";
import "@fontsource-variable/instrument-sans";
import { repository } from "../releases.mjs";
import { supportLinks } from "../project-content.mjs";
import { locales, pagePath } from "../../../docs/i18n/locales.mjs";
import { websiteLabels } from "../../../docs/i18n/website-upgrade.mjs";

const { title, description, locale, page, reference, t, software } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const project = websiteLabels(locale.code);
const navigation = ["downloads", "demos", "learn", "capabilities", "guide", "research", "docs"].map(path => [path, project[path] ?? t.nav[path]]);
const localized = (code) => base + (reference ? "/reference/" + code + "/" + reference + "/" : pagePath(code, page));
const alternates = locales.map(({ code }) => ({ code, href: localized(code) }));
---
<!doctype html>
<html lang={locale.code} dir={locale.dir || "ltr"}>
  <head>
    <HeadSEO {title} {description} {alternates} />
    {software && <script type="application/ld+json" set:html={JSON.stringify(software).replaceAll("<", "\\u003c")} />}
  </head>
  <body>
    <a class="skip" href="#content">{t.ui.skip}</a>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={base + pagePath(locale.code)}><span aria-hidden="true">◈</span> Linkwise</a>
        <nav aria-label={t.ui.navigation}>
          {navigation.map(([path, label]) => <a aria-current={page === path ? "page" : undefined} href={base + pagePath(locale.code, path)}>{label}</a>)}
        </nav>
        <a class="source" href={repository} lang="en" aria-label="Linkwise on GitHub" title="Linkwise on GitHub">
          <img src={base + "/github-invertocat-white.svg"} alt="" width="24" height="24" />
        </a>
        <details class="languages">
          <summary aria-label={t.ui.language}>{locale.name}</summary>
          <ul>{locales.map(({ code, name, dir }) => <li><a lang={code} dir={dir || "ltr"} hreflang={code}
            aria-current={code === locale.code ? "page" : undefined} href={localized(code)}>{name}</a></li>)}</ul>
        </details>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="wrap footer">
      <a class="brand" href={base + pagePath(locale.code)}><span aria-hidden="true">◈</span> Linkwise</a>
      <a href={repository + "/blob/main/LICENSE"}>Apache-2.0</a>
      <a href={supportLinks.releases}>{project.releaseNotes}</a>
      <a href={supportLinks.reportBug}>{project.reportBug}</a>
      <a href={supportLinks.knownIssues}>{project.knownIssues}</a>
      <a href={base + pagePath(locale.code) + "llms.txt"} hreflang={locale.code}>{t.ui.agents}</a>
    </footer>
  </body>
</html>
