---
import "../styles/global.css";
import HeadSEO from "../components/HeadSEO.astro";
import "@fontsource-variable/instrument-sans";
import { repository } from "../releases.mjs";
const { title, description, software } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navigation = [["Downloads", "/downloads/"], ["Mail forwarding", "/mail/"], ["Winlink Express", "/winlink/"]];
---
<!doctype html>
<html lang="en">
  <head>
    <HeadSEO {title} {description} />
    {software && <script type="application/ld+json" set:html={JSON.stringify(software).replaceAll("<", "\\u003c")} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={base + "/"}><span aria-hidden="true">◈</span> Linkwise</a>
        <nav aria-label="Main navigation">
          {navigation.map(([label, path]) => <a aria-current={Astro.url.pathname === base + path ? "page" : undefined} href={base + path}>{label}</a>)}
        </nav>
        <a class="source" href={repository}>GitHub ↗</a>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="wrap footer">
      <a class="brand" href={base + "/"}><span aria-hidden="true">◈</span> Linkwise</a>
      <a href={repository + "/blob/main/LICENSE"}>Apache-2.0</a>
      <a href={base + "/llms.txt"}>Install references for agents</a>
    </footer>
  </body>
</html>
