---
import { visualGuide } from "../../../docs/i18n/visual-guide.mjs";
import { pagePath } from "../../../docs/i18n/locales.mjs";
import { repository } from "../releases.mjs";

const { locale, t, base } = Astro.props;
const labels = visualGuide(locale.code);
const format = new Intl.NumberFormat(locale.code);
const seconds = new Intl.NumberFormat(locale.code, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const measurements = [
  { route: "VARA HF → VARA HF", delivered: 412, turnSeconds: 1.661 },
  { route: "VARA HF → Linkwise", delivered: 412, turnSeconds: 7.000 },
  { route: "Linkwise → VARA HF", delivered: 412 },
];
const turnScale = 8;
const bench = base + "/reference/" + locale.code + "/docs/testing/vara-interoperability.md/";
---
<nav class="bench-links" aria-label={t.nav.guide}>
  <a href="#start">{t.guide.start}</a>
  <a href="#workflow-examples">{labels.examples}</a>
  <a href="#performance">{labels.performance}</a>
</nav>
<section class="visual-section" aria-labelledby="workflow-examples">
  <h2 id="workflow-examples">{labels.examples}</h2>
  <div class="workflows">
    <article class="workflow" id="chat-example">
      <h3><a href="#chat">{t.guide.chat}</a></h3>
      <div class="terminal">
        <div class="terminal-head"><span>Linkwise</span><bdi>AA1AA ↔ BB2BB · BW500</bdi></div>
        <div class="stations">
          <div><span>{labels.caller} <bdi>AA1AA</bdi></span><code dir="ltr">/connect BB2BB</code></div>
          <div><span>{labels.listener} <bdi>BB2BB</bdi></span><code dir="ltr">/listen on</code></div>
        </div>
        <div class="screen" dir="ltr">
          <div class="message"><code>&lt;AA1AA     <b>|V</b>&gt;</code><span dir="auto">{labels.readyPrompt}</span></div>
          <div class="message"><code>&lt;BB2BB     <b>|V</b>&gt;</code><span dir="auto">{labels.readyReply}</span></div>
          <div class="terminal-command"><code>&gt; /encrypt</code><span dir="auto">{labels.caller} + {labels.listener}</span></div>
          <div class="message"><code>&lt;AA1AA     <b class="encrypted">|E</b>&gt;</code><span dir="auto">{labels.confirmed}</span></div>
        </div>
      </div>
      <p><code dir="ltr">linkwise chat --pki station-pki.json YOURCALL</code></p>
      <a href="#pki">{t.guide.pki}</a>
    </article>

    <article class="workflow" id="mail-example">
      <h3><a href="#mail">{t.nav.mail}</a></h3>
      <ol class="flow">
        <li>
          <span>{labels.caller} <bdi>AA1AA</bdi></span>
          <code dir="ltr">linkwise mail import ./mailbox message.eml</code>
        </li>
        <li>
          <span>{labels.exchange}</span>
          <div class="mail-ports">
            <div><span>{labels.listener} <bdi>BB2BB</bdi></span><code dir="ltr">linkwise mail listen ./mailbox BB2BB AA1AA</code></div>
            <div><span>{labels.caller} <bdi>AA1AA</bdi></span><code dir="ltr">linkwise mail exchange ./mailbox AA1AA BB2BB</code></div>
          </div>
        </li>
        <li>
          <span>{labels.received}</span>
          <code dir="ltr">./mailbox/inbox/*.b2f → Mid:</code>
          <code dir="ltr">linkwise mail export ./mailbox MESSAGE_ID &gt; received.eml</code>
        </li>
      </ol>
      <details class="mail-client">
        <summary>SMTP / IMAP</summary>
        <code dir="ltr">linkwise mail smtp ./mailbox AA1AA</code>
        <code dir="ltr">linkwise mail imap ./mailbox</code>
        <code dir="ltr">SMTP 127.0.0.1:2525 · IMAP 127.0.0.1:1143</code>
      </details>
      <div class="bench-links">
        <a href="#mail">{t.guide.mail}</a>
        <a href={base + pagePath(locale.code, "winlink") + "#bench-video"}>{t.winlink.video}</a>
      </div>
    </article>
  </div>

  <div class="support">
    <a href="#files"><strong>{t.guide.files}</strong><code dir="ltr">/sendfile PATH → /accept 1 PATH</code></a>
    <a href="#qsl"><strong>{t.guide.qsl}</strong><code dir="ltr">qsl card → qsl receive</code></a>
  </div>
</section>

<section class="visual-section assessment" aria-labelledby="performance">
  <h2 id="performance">{labels.performance}</h2>
  <div class="charts">
    <figure class="measurement" aria-labelledby="payload-chart">
      <h3 id="payload-chart">{labels.payload}</h3>
      <p>{labels.payloadNote}</p>
      <div class="rows">
        {measurements.map(({ route, delivered }) => (
          <div class="row">
            <div><bdi>{route}</bdi><strong><bdi>{format.format(delivered)} / {format.format(412)} B</bdi></strong></div>
            <div class="track segments" aria-hidden="true"><span></span><span></span><span></span></div>
          </div>
        ))}
      </div>
    </figure>
    <figure class="measurement" aria-labelledby="turn-chart">
      <h3 id="turn-chart">{labels.turn}</h3>
      <p>{labels.turnNote}</p>
      <div class="rows">
        {measurements.filter(row => row.turnSeconds !== undefined).map(({ route, turnSeconds }) => (
          <div class="row">
            <div><bdi>{route}</bdi><strong><bdi>{seconds.format(turnSeconds)} s</bdi></strong></div>
            <div class="track" dir="ltr" aria-hidden="true"><span style={`width: ${turnSeconds / turnScale * 100}%`}></span></div>
          </div>
        ))}
        <div class="axis" dir="ltr" aria-hidden="true">
          {[0, 2, 4, 6, 8].map(tick => <span>{format.format(tick)}{tick === turnScale && " s"}</span>)}
        </div>
      </div>
    </figure>
  </div>
  <p class="assessment-limits">{labels.limits}</p>
  <div class="bench-links">
    <a href={bench}>{labels.bench}</a>
    <a href={repository + "/blob/b85dbb12512009756fb4aaca760f79dd8a95dd15/lab-notes/lab-notes.tex#L2111-L2135"} hreflang="en">{labels.notes} ({t.ui.english})</a>
  </div>
</section>

<style>
  .visual-section { padding-block: 2rem; }
  .workflows, .charts, .support {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .workflow, .measurement, .support a {
    margin: 0;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    padding: clamp(.85rem, 2.5vw, 1.5rem);
  }
  h3 { font-size: 1.3rem; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .terminal {
    margin-block: 1.15rem .8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #0a1119;
    font-size: .875rem;
  }
  .terminal-head, .row > div:first-child {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .2rem .8rem;
  }
  .terminal-head, .stations { border-bottom: 1px solid var(--border); }
  .terminal-head, .screen, .stations { padding: .65rem .8rem; }
  .terminal-head, .stations span, .flow span, .terminal-command span { color: var(--muted); }
  .stations, .mail-ports { display: grid; gap: .65rem; }
  .stations { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stations code, .flow code, .support code { display: block; unicode-bidi: isolate; }
  .screen { display: grid; gap: .45rem; }
  .message, .terminal-command { display: grid; grid-template-columns: 8rem minmax(0, 1fr); align-items: baseline; }
  .message code { white-space: pre; }
  .screen span { text-align: left; }
  .message b, .terminal-command code { color: var(--primary); }
  .message b.encrypted { color: #b8c9ff; }
  .flow {
    list-style: none;
    margin: 1.15rem 0 .8rem;
    padding-inline-start: .9rem;
    border-inline-start: 1px solid var(--border);
    display: grid;
    gap: .75rem;
  }
  .flow > li { position: relative; }
  .flow > li::before {
    content: "";
    position: absolute;
    inset-inline-start: calc(-.9rem - 4px);
    inset-block-start: .6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
  }
  .flow li > span { color: var(--foreground); font-weight: 700; }
  .mail-ports { padding-block-start: .3rem; }
  .mail-client { margin-block: .65rem; }
  .mail-client summary { cursor: pointer; }
  .mail-client code { display: block; color: var(--muted); }
  .support { margin-block-start: 1rem; }
  .support a { text-decoration: none; }
  .support a:hover strong { text-decoration: underline; }
  .support code { color: var(--muted); }
  .assessment { border-block-start: 1px solid var(--border); }
  .measurement { display: flex; flex-direction: column; }
  .measurement p { color: var(--muted); font-size: .925rem; }
  .rows { display: grid; gap: .65rem; margin-block-start: auto; }
  .row { font-size: .875rem; }
  .row strong, .axis { font-variant-numeric: tabular-nums; }
  .track {
    height: .5rem;
    border-radius: .25rem;
    background: var(--background);
    overflow: hidden;
  }
  .track span { display: block; height: 100%; background: var(--primary); }
  .segments { display: grid; grid-template-columns: 203fr 6fr 203fr; }
  .segments span:nth-child(2) { background: #d5b2ff; }
  .segments span:nth-child(3) { background: #7ac9b5; }
  .axis { display: flex; justify-content: space-between; color: var(--muted); font-size: .75rem; }
  .assessment-limits { margin-block: 1rem .55rem; max-width: 80ch; }
  .bench-links { display: flex; flex-wrap: wrap; gap: .25rem 1.2rem; }
  @media (max-width: 800px) {
    .workflows, .charts { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 440px) {
    .support, .stations { grid-template-columns: minmax(0, 1fr); }
  }
</style>
