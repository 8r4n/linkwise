@startuml Linkwise_Operating_Loop
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Latin Modern Roman"
skinparam defaultFontSize 13
skinparam activity {
  BackgroundColor #EFF5F8
  BorderColor #2E6F95
  FontColor #16324F
  DiamondBackgroundColor #E9C46A
  DiamondBorderColor #16324F
  StartColor #2A9D8F
  EndColor #B23A48
}
skinparam ArrowColor #2E6F95

start
:Observe station evidence and validate freshness;
:Rank eligible channels; prepare radio and verify readback;
:Authorize and run one bounded session;
:Record outcomes for the next cycle;
stop
@enduml
