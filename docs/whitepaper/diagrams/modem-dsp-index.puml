@startuml Linkwise_DSP_Index
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam Padding 8
skinparam defaultFontName "Latin Modern Roman"
skinparam defaultFontSize 10
skinparam ArrowColor #2A9D8F
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 25
top to bottom direction
rectangle "48 kHz mono\ncontinuous samples" as Audio
rectangle "Rolling spectra\n128-sample hops" as Gate
rectangle "24-pilot search\n0 and +/-12 Hz\ntiming refinement" as Lock
rectangle "Tone correlations\n8 hypotheses / 3 bits" as Metrics
rectangle "Channel inverse\nscatter soft metrics" as Interleave
rectangle "Turbo + de-whiten\nCRC checked each iteration" as Decode
rectangle "Validated frame\nlevel / range / field" as Frame
Audio -right-> Gate
Gate -right-> Lock
Lock -right-> Metrics
Metrics -down-> Interleave
Interleave -left-> Decode
Decode -left-> Frame
@enduml
