# Optional radio profile settings. Copy to .env for a radio-connected Linux host.
RIGCTLD_HOST_DEVICE=/dev/ttyUSB0
RIGCTLD_DEVICE=/dev/ttyUSB0
RIGCTLD_MODEL=1
LINKWISE_RADIO_BACKEND=rigctld

# Writes remain disabled until the station limits below are explicitly set.
LINKWISE_RADIO_WRITES=false
LINKWISE_MIN_FREQ_HZ=
LINKWISE_MAX_FREQ_HZ=
LINKWISE_MAX_POWER_FRACTION=
LINKWISE_ALLOWED_MODES=
# Additional Hamlib controls require explicit per-control profile opt-in.
# Example: vfo,passband_hz,split_vfo,level:AF,function:NB
LINKWISE_ENABLED_HAMLIB_CONTROLS=
